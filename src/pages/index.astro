---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import {
  KINDS, TOPICS, TOPIC_GROUPS, GEOGRAPHIES, GEOGRAPHY_GROUPS,
  ORG_TYPES, LICENSING, ACCESS, STATUSES,
} from '../taxonomy'

const all = await getCollection('entries')

// `dead` entries stay in the repo and in index.json — the record of what
// used to exist is worth keeping — but they are not shown here.
const shown = all
  .filter((e) => e.data.status !== 'dead')
  .sort((a, b) =>
    a.data.name
      .replace(/^(the|a)\s+/i, '')
      .localeCompare(b.data.name.replace(/^(the|a)\s+/i, ''), 'en', {
        sensitivity: 'base',
      }),
  )

/* The index is one of the heaviest pages on the site: every entry is a
   server-rendered row, and the search needs all of them in the DOM at
   once. Shipping ~470 KB of row markup costs real first-paint time on
   slow connections, so only the first `INITIAL_ROWS` are rendered here —
   enough to fill the fold for people who never run the search script.
   The rest are sent once, as compact JSON, and built by the client before
   the search indexes the list. No-JS readers lose rows beyond the fold;
   everyone else gets the full index at a fraction of the weight. */
const INITIAL_ROWS = 16
const first = shown.slice(0, INITIAL_ROWS)
const rest = shown.slice(INITIAL_ROWS)

/* The rows travel as data, not markup. Only the fields the client cannot
   reconstruct are sent: everything else — labels, search text — is derived
   from the small `groups` payload below, sent once instead of inside every
   row. */
const groups = {
  k: KINDS,
  t: TOPICS,
  g: GEOGRAPHIES,
  s: STATUSES,
}

const rowPayload = (e: (typeof shown)[number]) => {
  const d = e.data
  return {
    i: e.id,
    n: d.name,
    b: d.blurb,
    u: d.url,
    k: d.kind,
    t: d.topics.join('|'),
    g: d.geography.join('|'),
    an: d.alternateNames.join('|'),
    o: d.orgType ?? '',
    l: d.licensing ?? '',
    a: d.access ?? '',
    s: d.status,
  }
}

const restJSON = JSON.stringify({ groups, rows: rest.map(rowPayload) }).replace(/</g, '\\u003c')

/**
 * Facet groups, in rail order. Only values actually in use are listed —
 * with thirty topics and forty-four places, showing the whole vocabulary
 * would bury the handful that return anything.
 *
 * `sub` splits a long facet into labelled runs. It is presentational
 * only: an entry still carries a flat term, so the grouping can change
 * without re-tagging anything.
 */
const GROUPS = [
  { key: 'kind', heading: 'Kind', labels: KINDS, get: (d: any) => [d.kind], sub: null },
  {
    key: 'topics', heading: 'Topic', labels: TOPICS, get: (d: any) => d.topics,
    sub: (v: string) => TOPIC_GROUPS.find((g) => (g.topics as string[]).includes(v))?.label ?? '',
  },
  {
    key: 'geography', heading: 'Where', labels: GEOGRAPHIES, get: (d: any) => d.geography,
    sub: (v: string) => GEOGRAPHY_GROUPS.find((g) => g.test(v as never))?.label ?? '',
  },
  /* Added once the index carried a critical mass of official sources.
     "Is this the government's own number or someone's estimate of it?"
     is a question people genuinely arrive with — unlike non-profit vs
     commercial, which legal form predicts badly. */
  { key: 'orgType', heading: 'Run by', labels: ORG_TYPES, get: (d: any) => (d.orgType ? [d.orgType] : []), sub: null },
  { key: 'licensing', heading: 'Licence', labels: LICENSING, get: (d: any) => (d.licensing ? [d.licensing] : []), sub: null },
  { key: 'access', heading: 'Cost', labels: ACCESS, get: (d: any) => (d.access ? [d.access] : []), sub: null },
] as const

const facets = GROUPS.map((g) => {
  const counts = new Map<string, number>()
  for (const e of shown) for (const v of g.get(e.data)) {
    counts.set(v, (counts.get(v) ?? 0) + 1)
  }
  const values = Object.keys(g.labels)
    .filter((v) => counts.has(v))
    .map((v) => ({
      value: v,
      label: (g.labels as Record<string, string>)[v],
      count: counts.get(v)!,
      sub: g.sub ? g.sub(v) : '',
    }))

  // Only label the runs when more than one is actually present.
  const subs = [...new Set(values.map((v) => v.sub))].filter(Boolean)
  const grouped = subs.length > 1

  const max = Math.max(1, ...values.map((v) => v.count))
  const subgroups = grouped
    ? subs.map((sub) => ({ sub, values: values.filter((v) => v.sub === sub) }))
    : []
  return { ...g, values, max, grouped, subgroups }
})
  // A facet with a single value is a filter with nothing to choose
  // between — it only ever narrows to what you already see.
  .filter((g) => g.values.length > 1)

/** Kind counts in taxonomy order — drives the composition strip. */
const composition = facets.find((f) => f.key === 'kind')!.values

const recent = [...shown]
  .sort((a, b) => b.data.added.getTime() - a.data.added.getTime())
  .slice(0, 4)

const updated = shown.reduce<Date | null>(
  (latest, e) => (!latest || e.data.added > latest ? e.data.added : latest),
  null,
)

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })

/* The index is a list of things, so say so. Search engines will render a
   carousel from this; more usefully, it makes the page machine-readable
   to anything that is not this site's own JSON. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Soochi',
  numberOfItems: shown.length,
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: shown.length,
    itemListElement: shown.slice(0, 100).map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/e/${e.id}`, Astro.site).toString(),
      name: e.data.name,
    })),
  },
}
---

<Base schema={schema}>
  <section class="opening">
    <p class="statement">
      Find organisations, datasets, tools and archives for work on public
      problems — in one searchable index, with a growing focus on
      <em>India</em>.
    </p>

    {/* A directory has to look alive to be worth returning to, and the
        newest entries are the only honest evidence of that. */}
    <aside class="recent">
      <h2>Recently added</h2>
      <ul>
        {recent.map((e) => (
          <li data-kind={e.data.kind}>
            <a href={e.data.url} rel="noopener">
              <span class="dot" aria-hidden="true" />
              {e.data.name}
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <p class="opening-meta">
      {shown.length} entries across {composition.length} kinds{
        updated ? ` · last added ${fmtDate(updated)}` : ''
      }
    </p>

    {/* The strip does structural work: it is the rule that closes the
        masthead and opens the index, and it happens to be true. */}
    <div
      class="strip"
      role="img"
      aria-label={`Composition by kind: ${composition
        .map((c) => `${c.count} ${c.label.toLowerCase()}`)
        .join(', ')}.`}
    >
      {composition.map((c) => (
        <span data-kind={c.value} style={`--n:${c.count}`} title={`${c.label} — ${c.count}`} />
      ))}
    </div>
  </section>

  <div class="index">
    <form class="rail" role="search" aria-label="Filter the index">
      <div class="search">
        <label class="sr" for="q">Search the index</label>
        <input
          id="q"
          type="search"
          name="q"
          placeholder="Search"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="clear" type="button" aria-label="Clear search">×</button>
      </div>

      {/* On a phone the whole vocabulary sits between you and the first
          entry, so below the breakpoint it collapses behind this. */}
      <button class="filters-toggle" type="button" aria-expanded="false" aria-controls="facet-groups">
        Filters<span class="ft-count" hidden></span>
      </button>

      <div class="facet-groups" id="facet-groups">
        {/* Above the vocabulary, not below it: selections accumulate, and
            the rail scrolls, so the way out has to be where the clicking
            happens rather than past six groups of terms. */}
        <button class="reset" type="button" hidden>Clear all filters</button>

        {facets.map((g) => (
          <div class="facet" data-group={g.key}>
            <h2 id={`facet-${g.key}`}>{g.heading}</h2>
            {g.grouped ? (
              <div class="facet-subgroups" aria-labelledby={`facet-${g.key}`}>
                {g.subgroups.map((sg) => (
                  <div class="facet-subgroup">
                    <h3>{sg.sub}</h3>
                    <ul>
                      {sg.values.map((v) => (
                        <li>
                          <button
                            type="button"
                            aria-pressed="false"
                            data-value={v.value}
                            data-kind={g.key === 'kind' ? v.value : undefined}
                            style={`--share:${Math.round((v.count / g.max) * 100)}%`}
                          >
                            {g.key === 'kind' && <span class="dot" aria-hidden="true" />}
                            <span class="label">{v.label}</span>
                            <span class="leader" aria-hidden="true" />
                            <span class="count">{v.count}</span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ) : (
              <ul aria-labelledby={`facet-${g.key}`}>
                {g.values.map((v) => (
                  <li>
                    <button
                      type="button"
                      aria-pressed="false"
                      data-value={v.value}
                      data-kind={g.key === 'kind' ? v.value : undefined}
                      style={`--share:${Math.round((v.count / g.max) * 100)}%`}
                    >
                      {g.key === 'kind' && <span class="dot" aria-hidden="true" />}
                      <span class="label">{v.label}</span>
                      <span class="leader" aria-hidden="true" />
                      <span class="count">{v.count}</span>
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </form>

    <div class="list">
      <p class="sr" aria-live="polite" data-live></p>

      <ul class="entries">
        {first.map((e, i) => {
          const d = e.data
          const labels = [
            KINDS[d.kind],
            ...d.topics.map((t) => TOPICS[t]),
            ...d.geography.map((g) => GEOGRAPHIES[g]),
          ]
          return (
            <li
              class="entry"
              style={`--i:${Math.min(i, 14)}`}
              data-status={d.status}
              data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}
              data-kind={d.kind}
              data-topics={d.topics.join('|')}
              data-geography={d.geography.join('|')}
              data-org-type={d.orgType ?? ''}
              data-licensing={d.licensing ?? ''}
              data-access={d.access ?? ''}
              data-name={d.name.toLowerCase()}
              data-text={[d.name, ...d.alternateNames, d.blurb, ...labels]
                .join(' ')
                .toLowerCase()}
            >
              {/* The row opens the entry; the arrow is the shortcut
                  straight to the site for people who only want the link.
                  Two siblings rather than nested anchors. */}
              <a class="entry-link" href={`/e/${e.id}`}>
                <span class="head">
                  <span class="name" data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}>
                    {d.name}
                  </span>
                </span>
                <p class="blurb">{d.blurb}</p>
                {/* Kind, one topic, place. The rail is where the full
                    taxonomy lives — repeating all of it here made the
                    loudest thing in each row its metadata. */}
                <p class="facets">
                  <span class="chip chip--kind">{KINDS[d.kind]}</span>
                  <span class="chip">{TOPICS[d.topics[0]]}</span>
                  <span class="chip">
                    {d.geography.map((g) => GEOGRAPHIES[g]).join(', ')}
                  </span>
                </p>
              </a>

              <a class="out" href={d.url} rel="noopener" title={`Go straight to ${d.name}`}>
                <span class="sr">Go straight to {d.name}</span>
                <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path
                    d="M1.6 8.4 8.4 1.6M3.4 1.6h5v5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          )
        })}
      </ul>

      {/* The rows below the fold are carried here as data rather than
          markup. Building them in the script below is a few hundred
          microseconds; shipping them as HTML is half a megabyte. */}
      <script is:inline type="application/json" id="entry-data" set:html={restJSON} />

      {/* "Nothing matches" is exactly when someone needs to be told where
          else to look. The link is derived from the index rather than a
          hand-kept list, so it cannot go stale. */}
      <p class="empty" hidden>
        Nothing matches that combination.
        <button class="reset" type="button">Clear all filters</button>
        <span class="empty-alt">
          Or look at <a href="/directories">other directories</a> — several go
          deeper on one subject than this index does.
        </span>
      </p>
    </div>
  </div>
</Base>

<script>
  const GROUPS = ['kind', 'topics', 'geography', 'orgType', 'licensing', 'access'] as const
  type Group = (typeof GROUPS)[number]

  const rail = document.querySelector('.rail') as HTMLFormElement
  const input = document.querySelector('#q') as HTMLInputElement
  const search = document.querySelector('.search') as HTMLElement
  const live = document.querySelector('[data-live]') as HTMLElement
  const emptyMsg = document.querySelector('.empty') as HTMLElement
  const resetButtons = document.querySelectorAll<HTMLButtonElement>('.reset')
  const filtersToggle = document.querySelector('.filters-toggle') as HTMLButtonElement
  const ftCount = document.querySelector('.ft-count') as HTMLElement
  const listEl = document.querySelector('.entries') as HTMLUListElement

  /* The rows beyond the fold arrive as JSON (see #entry-data). Build them
     into the list before the search below indexes `.entry` elements, so
     the whole directory is searchable rather than just the fold. */
  type Row = {
    i: string
    n: string
    b: string
    u: string
    k: string
    t: string
    g: string
    an: string
    o: string
    l: string
    a: string
    s: string
  }

  const dataEl = document.getElementById('entry-data')
  if (dataEl) {
    const payload = JSON.parse(dataEl.textContent ?? '{"groups":{},"rows":[]}') as {
      groups: { k: Record<string, string>; t: Record<string, string>; g: Record<string, string>; s: Record<string, string> }
      rows: Row[]
    }
    const split = (v: string) => (v ? v.split('|').filter(Boolean) : [])
    const statusLabel = (s: string) =>
      s !== 'live' ? payload.groups.s[s] ?? '' : ''

    for (const d of payload.rows) {
      const topics = split(d.t)
      const geos = split(d.g)
      const kindLabel = payload.groups.k[d.k]
      const searchLabels = [
        kindLabel,
        ...topics.map((t) => payload.groups.t[t] ?? ''),
        ...geos.map((g) => payload.groups.g[g] ?? ''),
      ]
      const dataText = [d.n, ...split(d.an), d.b, ...searchLabels]
        .join(' ')
        .toLowerCase()

      const li = document.createElement('li')
      li.className = 'entry'
      li.style.setProperty('--i', '0')
      li.dataset.status = d.s
      const sl = statusLabel(d.s)
      if (sl) li.dataset.statusLabel = sl
      li.dataset.kind = d.k
      li.dataset.topics = d.t
      li.dataset.geography = d.g
      li.dataset.orgType = d.o
      li.dataset.licensing = d.l
      li.dataset.access = d.a
      li.dataset.name = d.n.toLowerCase()
      li.dataset.text = dataText

      const link = document.createElement('a')
      link.className = 'entry-link'
      link.href = `/e/${d.i}`

      const head = document.createElement('span')
      head.className = 'head'
      const name = document.createElement('span')
      name.className = 'name'
      if (sl) name.dataset.statusLabel = sl
      name.textContent = d.n
      head.append(name)
      link.append(head)

      const blurb = document.createElement('p')
      blurb.className = 'blurb'
      blurb.textContent = d.b
      link.append(blurb)

      const facets = document.createElement('p')
      facets.className = 'facets'
      const chips = [
        ['chip chip--kind', kindLabel ?? ''],
        ['chip', topics.length ? payload.groups.t[topics[0]] ?? '' : ''],
        ['chip', geos.map((g) => payload.groups.g[g] ?? '').join(', ')],
      ]
      for (const [cls, label] of chips) {
        const span = document.createElement('span')
        span.className = cls
        span.textContent = label
        facets.append(span)
      }
      link.append(facets)
      li.append(link)

      const out = document.createElement('a')
      out.className = 'out'
      out.href = d.u
      out.rel = 'noopener'
      out.title = `Go straight to ${d.n}`
      const sr = document.createElement('span')
      sr.className = 'sr'
      sr.textContent = `Go straight to ${d.n}`
      out.append(sr)
      out.insertAdjacentHTML(
        'beforeend',
        '<svg viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M1.6 8.4 8.4 1.6M3.4 1.6h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      )
      li.append(out)

      listEl.append(li)
    }
    dataEl.remove()
  }

  filtersToggle.addEventListener('click', () => {
    const open = rail.toggleAttribute('data-open')
    filtersToggle.setAttribute('aria-expanded', String(open))
  })

  const split = (s: string | undefined) => (s ? s.split('|').filter(Boolean) : [])

  /** Search normalisation keeps punctuation from blocking obvious matches. */
  function normText(s: string): string {
    return s
      .toLowerCase()
      .replace(/[^a-z0-9\s]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
  }

  const entries = [...document.querySelectorAll<HTMLElement>('.entry')].map((el) => ({
    el,
    text: normText(el.dataset.text ?? ''),
    name: normText(el.dataset.name ?? ''),
    kind: split(el.dataset.kind),
    topics: split(el.dataset.topics),
    geography: split(el.dataset.geography),
    orgType: split(el.dataset.orgType),
    licensing: split(el.dataset.licensing),
    access: split(el.dataset.access),
  }))

  const state: { q: string } & Record<Group, Set<string>> = {
    q: '',
    kind: new Set(),
    topics: new Set(),
    geography: new Set(),
    orgType: new Set(),
    licensing: new Set(),
    access: new Set(),
  }

  type Entry = (typeof entries)[number]

  /** Escape regex special characters so short terms can safely seed a \b check. */
  function escapeRegex(s: string): string {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
  }

  /**
   * True when every character of `q` appears in `target` in order —
   * "agrcultre" matches "agriculture", but "agri" does not match
   * "agree". Used as a cheap typo-tolerant fallback on the name field
   * for terms of four or more characters.
   */
  function isSubsequence(q: string, target: string): boolean {
    let qi = 0
    for (let ti = 0; ti < target.length && qi < q.length; ti++) {
      if (target[ti] === q[qi]) qi++
    }
    return qi === q.length
  }

  /**
   * Score an entry against the search query.  Every whitespace-delimited
   * term of two or more characters must match somewhere; the entry is
   * excluded (returns -1) if any term misses entirely.
   *
   * Name matches carry more weight than blurb / label matches, so
   * results sort by relevance instead of alphabetically.
   */
  function scoreSearch(e: Entry, raw: string): number {
    const terms = normText(raw).split(/\s+/).filter((t) => t.length >= 2)
    if (!terms.length) return 0

    let total = 0
    for (const term of terms) {
      let best = 0

      // Word-start match in the entry name
      if (new RegExp('\\b' + escapeRegex(term)).test(e.name)) {
        best = 10
      }
      // Substring match in the entry name
      else if (e.name.includes(term)) {
        best = 6
      }
      // Word-start match anywhere in the full text
      else if (new RegExp('\\b' + escapeRegex(term)).test(e.text)) {
        best = 3
      }
      // Substring match in the full text
      else if (e.text.includes(term)) {
        best = 1
      }
      // Typo-tolerant: subsequence match against each word of the name
      else if (term.length >= 4) {
        const nameWords = e.name.split(/\s+/)
        if (nameWords.some((w) => isSubsequence(term, w))) {
          best = 0.5
        }
      }

      // Every term must land somewhere or the entry is excluded.
      if (best === 0) return -1
      total += best
    }
    return total
  }

  /** `skip` leaves one group out — facet counts stay honest. */
  function matches(e: Entry, skip: Group | null) {
    for (const g of GROUPS) {
      if (g === skip) continue
      const sel = state[g]
      if (sel.size && !e[g].some((v) => sel.has(v))) return false
    }
    return true
  }

  function apply() {
    const terms = normText(state.q).split(/\s+/).filter((t) => t.length >= 2)

    // Score every entry, then collect the ones that pass both search
    // and active facet selections.
    const scored = entries.map((e) => ({
      e,
      score: terms.length ? scoreSearch(e, state.q) : 0,
      facetOk: matches(e, null),
    }))

    const visible = scored.filter((s) => s.facetOk && s.score >= 0)

    // Sort: highest score first, then alphabetical for ties so the
    // order is stable between keystrokes.
    visible.sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score
      return a.e.name.localeCompare(b.e.name, 'en', { sensitivity: 'base' })
    })

    // Move visible entries to the top in sorted order in one DOM pass.
    const frag = document.createDocumentFragment()
    for (const s of visible) frag.appendChild(s.e.el)
    listEl.prepend(frag)

    // Hide everything that didn't make the cut.
    for (const s of scored) {
      s.e.el.hidden = !(s.facetOk && s.score >= 0)
    }

    // Redraw the rail: counts, bar widths, and what has gone empty.
    for (const g of GROUPS) {
      const pool = entries.filter((e) => matches(e, g))
      const buttons = rail.querySelectorAll<HTMLButtonElement>(
        `.facet[data-group="${g}"] button`,
      )
      let max = 1
      const counts = new Map<HTMLButtonElement, number>()
      for (const b of buttons) {
        const v = b.dataset.value!
        const n = pool.filter((e) => e[g].includes(v)).length
        counts.set(b, n)
        if (n > max) max = n
      }
      for (const [b, n] of counts) {
        b.style.setProperty('--share', `${Math.round((n / max) * 100)}%`)
        b.querySelector('.count')!.textContent = String(n)
        const selected = b.getAttribute('aria-pressed') === 'true'
        if (n === 0 && !selected) b.dataset.empty = ''
        else delete b.dataset.empty
      }
    }

    const active = GROUPS.reduce((n, g) => n + state[g].size, 0)
    const filtering = state.q !== '' || active > 0
    emptyMsg.hidden = visible.length > 0
    search.toggleAttribute('data-filled', state.q !== '')

    /* Say how many terms are on. Within a group the terms are OR'd, so
       three selections is a wider result than one — "clear all filters"
       left that count invisible, and a wide result then looks like a
       filter that did nothing. */
    const resetLabel = active
      ? `Clear ${active} filter${active === 1 ? '' : 's'}${state.q ? ' and search' : ''}`
      : 'Clear search'
    for (const b of resetButtons) {
      b.hidden = !filtering
      b.textContent = resetLabel
    }
    ftCount.textContent = String(active)
    ftCount.hidden = active === 0
    live.textContent = `${visible.length} ${visible.length === 1 ? 'entry' : 'entries'}`

    writeUrl(filtering)
  }

  function writeUrl(filtering: boolean) {
    const p = new URLSearchParams()
    if (state.q) p.set('q', state.q)
    for (const g of GROUPS) if (state[g].size) p.set(g, [...state[g]].join(','))
    const url = filtering ? `?${p}` : location.pathname
    history.replaceState(null, '', url)
  }

  function readUrl() {
    const p = new URLSearchParams(location.search)
    state.q = (p.get('q') ?? '').trim().toLowerCase()
    input.value = p.get('q') ?? ''
    for (const g of GROUPS) {
      const vals = (p.get(g) ?? '').split(',').filter(Boolean)
      state[g] = new Set(vals)
      for (const b of rail.querySelectorAll<HTMLButtonElement>(
        `.facet[data-group="${g}"] button`,
      )) {
        b.setAttribute('aria-pressed', String(vals.includes(b.dataset.value!)))
      }
    }
  }

  rail.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.facet button')
    if (!b) return
    const g = b.closest<HTMLElement>('.facet')!.dataset.group as Group
    const v = b.dataset.value!
    const selected = state[g].has(v)
    // A facet that would return nothing is a dead end — ignore the click.
    if (!selected && b.dataset.empty !== undefined) return
    if (selected) state[g].delete(v)
    else state[g].add(v)
    b.setAttribute('aria-pressed', String(!selected))
    apply()
  })

  input.addEventListener('input', () => {
    state.q = input.value.trim().toLowerCase()
    apply()
  })

  rail.addEventListener('submit', (ev) => ev.preventDefault())

  document.querySelector('.search .clear')!.addEventListener('click', () => {
    input.value = ''
    state.q = ''
    input.focus()
    apply()
  })

  for (const b of resetButtons) {
    b.addEventListener('click', () => {
      state.q = ''
      input.value = ''
      for (const g of GROUPS) {
        state[g].clear()
        for (const btn of rail.querySelectorAll(`.facet[data-group="${g}"] button`)) {
          btn.setAttribute('aria-pressed', 'false')
        }
      }
      apply()
    })
  }

  readUrl()
  apply()
</script>
