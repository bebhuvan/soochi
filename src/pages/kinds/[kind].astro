---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import {
  KINDS, KIND_NOTES, TOPICS, GEOGRAPHIES, STATUSES, keysOf,
  type Kind,
} from '../../taxonomy'

export async function getStaticPaths() {
  const all = await getCollection('entries')
  const live = all.filter((e) => e.data.status !== 'dead')
  const kindKeys = keysOf(KINDS)

  return kindKeys.map((kind) => {
    const entries = live
      .filter((e) => e.data.kind === kind)
      .sort((a, b) =>
        a.data.name
          .replace(/^(the|a)\s+/i, '')
          .localeCompare(b.data.name.replace(/^(the|a)\s+/i, ''), 'en', {
            sensitivity: 'base',
          }),
      )
    return {
      params: { kind },
      props: { kind, entries },
    }
  })
}

const { kind, entries } = Astro.props
const kindName = KINDS[kind as Kind]
const kindNote = KIND_NOTES[kind as Kind]
const allKinds = keysOf(KINDS)
const otherKinds = allKinds.filter((k) => k !== kind)

const pageTitle = `${kindName}s — Civic Directory`
const pageDesc = `${kindNote}. Browse ${entries.length} verified public-interest ${kindName.toLowerCase()}s in Soochi.`
const canonicalUrl = new URL(`/kinds/${kind}`, Astro.site).toString()

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${kindName}s Directory`,
    description: pageDesc,
    url: canonicalUrl,
    numberOfItems: entries.length,
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: entries.length,
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/e/${e.id}`, Astro.site).toString(),
        name: e.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Index', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Kinds', item: new URL('/kinds', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: `${kindName}s`, item: canonicalUrl },
    ],
  },
]
---

<Base
  title={pageTitle}
  description={pageDesc}
  schema={schema}
  ogImage={`/og/kind-${kind}.png`}
>
  <div class="kind-page" data-kind={kind}>
    <div class="kind-nav-back">
      <a class="back" href="/kinds">
        <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M6.2 1.4 2.6 5l3.6 3.6" stroke="currentColor" stroke-width="1.4"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All kinds
      </a>
      <span class="kind-tally">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</span>
    </div>

    <header class="kind-head">
      <p class="kind-tag"><span class="dot" aria-hidden="true" />{kindName}</p>
      <h1>{kindName}s</h1>
      <p class="statement">{kindNote}.</p>
    </header>

    <div class="entries-section">
      <ul class="entries">
        {entries.map((e) => {
          const d = e.data
          return (
            <li
              class="entry"
              data-status={d.status}
              data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}
              data-kind={d.kind}
            >
              <a class="entry-link" href={`/e/${e.id}`}>
                <span class="head">
                  <span class="name" data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}>
                    {d.name}
                  </span>
                </span>
                <p class="blurb">{d.blurb}</p>
                <p class="facets">
                  <span class="chip chip--kind">{KINDS[d.kind]}</span>
                  {d.topics.slice(0, 2).map((t) => (
                    <span class="chip">{TOPICS[t]}</span>
                  ))}
                  <span class="chip">
                    {d.geography.map((g) => GEOGRAPHIES[g]).join(', ')}
                  </span>
                </p>
              </a>

              <a class="out" href={d.url} rel="noopener" title={`Go straight to ${d.name}`}>
                <span class="sr">Go straight to {d.name}</span>
                <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path
                    d="M1.6 8.4 8.4 1.6M3.4 1.6h5v5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          )
        })}
      </ul>
    </div>

    <footer class="other-kinds">
      <h2>Other kinds</h2>
      <div class="kind-chips">
        {otherKinds.map((k) => (
          <a class="kind-chip" data-kind={k} href={`/kinds/${k}`}>
            <span class="dot" aria-hidden="true" />
            {KINDS[k]}s
          </a>
        ))}
      </div>
    </footer>
  </div>
</Base>

<style>
  .kind-page {
    max-width: 44rem;
    padding-block: 2.25rem 6rem;
  }

  .kind-nav-back {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .kind-tally {
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .kind-head {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }

  .kind-tag {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.875rem;
    font-size: 0.6875rem;
    font-weight: 700;
    display: flex;
  }

  .kind-tag .dot {
    background: var(--k);
    border-radius: 50%;
    inline-size: 6px;
    block-size: 6px;
  }

  .kind-head h1 {
    font-size: 2.5rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .statement {
    font-family: var(--font-text);
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
    text-wrap: pretty;
  }

  .entries-section {
    padding-top: 3rem;
  }

  .other-kinds {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .other-kinds h2 {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .kind-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kind-chip {
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .kind-chip .dot {
    background: var(--k);
    border-radius: 50%;
    inline-size: 5px;
    block-size: 5px;
  }

  .kind-chip:hover {
    border-color: var(--k);
    color: var(--ink);
  }
</style>
