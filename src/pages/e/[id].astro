---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import {
  KINDS, ORG_TYPES, TOPICS, GEOGRAPHIES, LICENSING, ACCESS, STATUSES,
} from '../../taxonomy'

export async function getStaticPaths() {
  const entries = await getCollection('entries')
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const d = entry.data
const { Content } = await render(entry)

const host = new URL(d.url).host.replace(/^www\./, '')

/** Only rows that have something in them. */
const facts = [
  ['Kind', KINDS[d.kind]],
  ['Run by', d.orgType ? ORG_TYPES[d.orgType] : null],
  ['Founded', d.founded ? String(d.founded) : null],
  ['Topics', d.topics.map((t) => TOPICS[t]).join(', ')],
  ['Where', d.geography.map((g) => GEOGRAPHIES[g]).join(', ')],
  ['Licence', d.licensing ? LICENSING[d.licensing] : null],
  ['Cost', d.access ? ACCESS[d.access] : null],
  ['Licence terms', d.license ?? null],
  ['Based in', d.location ? [d.location.city, d.location.region].filter(Boolean).join(', ') || null : null],
  ['Status', d.status !== 'live' ? STATUSES[d.status] : null],
].filter((r): r is [string, string] => Boolean(r[1]))

const fmtDate = (x: Date) =>
  x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })

/* Map our kinds onto schema.org types so each entry describes itself as
   the sort of thing it is, not just as a web page. */
const SCHEMA_TYPE: Record<string, string> = {
  organisation: 'Organization',
  community: 'Organization',
  /* `DataCatalog`, not `Dataset` — the kind now spans whole statistical
     services as well as single surveys, and a catalogue containing one
     dataset is still a truthful catalogue. The reverse is not true. */
  dataset: 'DataCatalog',
  directory: 'CollectionPage',
  tool: 'SoftwareApplication',
  publication: 'Periodical',
  dashboard: 'WebApplication',
  archive: 'ArchiveComponent',
}

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': SCHEMA_TYPE[d.kind] ?? 'WebSite',
    name: d.name,
    description: d.blurb,
    url: d.url,
    ...(d.alternateNames.length ? { alternateName: d.alternateNames } : {}),
    ...(d.founded ? { foundingDate: String(d.founded) } : {}),
    ...(d.license ? { license: d.license } : {}),
    ...(d.people.length
      ? { founder: d.people.map((p) => ({ '@type': 'Person', name: p.name })) }
      : {}),
    ...(d.location?.city
      ? {
          address: {
            '@type': 'PostalAddress',
            addressLocality: d.location.city,
            ...(d.location.region ? { addressRegion: d.location.region } : {}),
          },
        }
      : {}),
    ...(d.links.length ? { sameAs: d.links.map((l) => l.url) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Index', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: d.name },
    ],
  },
]
---

<Base title={d.name} description={d.blurb} schema={schema}>
  <article class="entry-page" data-kind={d.kind}>
    <a class="back" href="/">
      <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <path d="M6.2 1.4 2.6 5l3.6 3.6" stroke="currentColor" stroke-width="1.4"
          stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      All entries
    </a>

    <header>
      <p class="kind"><span class="dot" aria-hidden="true" />{KINDS[d.kind]}</p>
      <h1>{d.name}</h1>
      <p class="blurb">{d.blurb}</p>

      <a class="visit" href={d.url} rel="noopener">
        {host}
        <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M1.6 8.4 8.4 1.6M3.4 1.6h5v5" stroke="currentColor" stroke-width="1.4"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </header>

    {entry.body?.trim() && (
      <section class="note">
        <Content />
      </section>
    )}

    <div class="panels">
      <section class="facts">
        <h2>Details</h2>
        <dl>
          {facts.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </section>

      {d.people.length > 0 && (
        <section>
          <h2>People</h2>
          <ul class="people">
            {d.people.map((p) => (
              <li>
                {p.url ? <a href={p.url} rel="noopener">{p.name}</a> : <span>{p.name}</span>}
                {p.role && <span class="role">{p.role}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Its own section rather than another row in "Elsewhere": an API
          is not a link about the thing, it is a different way in. */}
      {/* Only where we have actually looked. An entry with no `retrieval`
          block is unchecked, not API-less, and saying "not available"
          for it would be inventing a fact. */}
      {d.retrieval && (d.retrieval.apiUrl || d.retrieval.api !== undefined) && (
        <section>
          <h2>API</h2>
          <ul class="links">
            {d.retrieval.apiUrl ? (
              <li>
                <a href={d.retrieval.apiUrl} rel="noopener">
                  {d.retrieval.apiVia ? `Via ${d.retrieval.apiVia}` : 'API documentation'}
                </a>
              </li>
            ) : (
              <li class="plain">Not available</li>
            )}
          </ul>
        </section>
      )}

      {(d.links.length > 0 || d.sourceUrl) && (
        <section>
          <h2>Elsewhere</h2>
          <ul class="links">
            {d.sourceUrl && (
              <li><a href={d.sourceUrl} rel="noopener">The data itself</a></li>
            )}
            {d.links.map((l) => (
              <li><a href={l.url} rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      {d.contact && (
        <section>
          <h2>Contact</h2>
          <ul class="links">
            {d.contact.email && (
              <li><a href={`mailto:${d.contact.email}`}>{d.contact.email}</a></li>
            )}
            {d.contact.phone && (
              <li><a href={`tel:${d.contact.phone.replace(/\s+/g, '')}`}>{d.contact.phone}</a></li>
            )}
            {d.contact.address && <li class="plain">{d.contact.address}</li>}
          </ul>
        </section>
      )}
    </div>

    <footer class="provenance">
      Added {fmtDate(d.added)}{d.submittedBy ? ` by ${d.submittedBy}` : ''}.
      {d.verifiedAt
        ? ` Checked against the source ${fmtDate(d.verifiedAt)}.`
        : ' Not yet checked against the source — the description may be imprecise.'}
      {' '}Something wrong or missing? <a href="/contribute">Tell us</a>.
    </footer>
  </article>
</Base>
