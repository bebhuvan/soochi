---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import {
  KINDS, TOPICS, TOPIC_GROUPS, GEOGRAPHIES, STATUSES, keysOf,
  type Topic,
} from '../../taxonomy'

export async function getStaticPaths() {
  const all = await getCollection('entries')
  const live = all.filter((e) => e.data.status !== 'dead')
  const topicKeys = keysOf(TOPICS)

  return topicKeys.map((topic) => {
    const entries = live
      .filter((e) => e.data.topics.includes(topic))
      .sort((a, b) =>
        a.data.name
          .replace(/^(the|a)\s+/i, '')
          .localeCompare(b.data.name.replace(/^(the|a)\s+/i, ''), 'en', {
            sensitivity: 'base',
          }),
      )
    return {
      params: { topic },
      props: { topic, entries },
    }
  })
}

const { topic, entries } = Astro.props
const topicName = TOPICS[topic as Topic]

const group = TOPIC_GROUPS.find((g) => (g.topics as string[]).includes(topic))
const siblings = group ? group.topics.filter((t) => t !== topic) : []

// Composition counts
const kindCounts = new Map<string, number>()
for (const e of entries) {
  kindCounts.set(e.data.kind, (kindCounts.get(e.data.kind) ?? 0) + 1)
}
const composition = keysOf(KINDS)
  .filter((k) => kindCounts.has(k))
  .map((k) => ({
    kind: k,
    label: KINDS[k],
    count: kindCounts.get(k)!,
  }))

const pageTitle = `${topicName} — Civic Data, Tools & Organisations`
const pageDesc = `A curated index of ${entries.length} open datasets, tools, research and organisations working on ${topicName.toLowerCase()} in India and globally.`
const canonicalUrl = new URL(`/topics/${topic}`, Astro.site).toString()

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${topicName} Directory`,
    description: pageDesc,
    url: canonicalUrl,
    numberOfItems: entries.length,
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: entries.length,
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/e/${e.id}`, Astro.site).toString(),
        name: e.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Index', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Topics', item: new URL('/topics', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: topicName, item: canonicalUrl },
    ],
  },
]
---

<Base title={pageTitle} description={pageDesc} schema={schema}>
  <div class="topic-page">
    <div class="topic-nav-back">
      <a class="back" href="/topics">
        <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M6.2 1.4 2.6 5l3.6 3.6" stroke="currentColor" stroke-width="1.4"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All topics
      </a>
      {group && <span class="group-label">{group.label}</span>}
    </div>

    <header class="topic-head">
      <p class="section-tag">Topic directory</p>
      <h1>{topicName}</h1>
      <p class="statement">
        Verified datasets, public-interest software, research publications and organisations
        addressing <em>{topicName.toLowerCase()}</em>.
      </p>

      <p class="topic-meta">
        {entries.length} {entries.length === 1 ? 'entry' : 'entries'} across {composition.length} {composition.length === 1 ? 'kind' : 'kinds'}
      </p>

      {composition.length > 0 && (
        <div
          class="strip"
          role="img"
          aria-label={`Composition: ${composition
            .map((c) => `${c.count} ${c.label.toLowerCase()}`)
            .join(', ')}.`}
        >
          {composition.map((c) => (
            <span data-kind={c.kind} style={`--n:${c.count}`} title={`${c.label} — ${c.count}`} />
          ))}
        </div>
      )}
    </header>

    <div class="entries-section">
      {entries.length === 0 ? (
        <p class="empty-state">No active entries currently listed for {topicName}.</p>
      ) : (
        <ul class="entries">
          {entries.map((e) => {
            const d = e.data
            return (
              <li
                class="entry"
                data-status={d.status}
                data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}
                data-kind={d.kind}
              >
                <a class="entry-link" href={`/e/${e.id}`}>
                  <span class="head">
                    <span class="name" data-status-label={d.status !== 'live' ? STATUSES[d.status] : undefined}>
                      {d.name}
                    </span>
                  </span>
                  <p class="blurb">{d.blurb}</p>
                  <p class="facets">
                    <span class="chip chip--kind">{KINDS[d.kind]}</span>
                    {d.topics.slice(0, 2).map((t) => (
                      <span class="chip">{TOPICS[t]}</span>
                    ))}
                    <span class="chip">
                      {d.geography.map((g) => GEOGRAPHIES[g]).join(', ')}
                    </span>
                  </p>
                </a>

                <a class="out" href={d.url} rel="noopener" title={`Go straight to ${d.name}`}>
                  <span class="sr">Go straight to {d.name}</span>
                  <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path
                      d="M1.6 8.4 8.4 1.6M3.4 1.6h5v5"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            )
          })}
        </ul>
      )}
    </div>

    {siblings.length > 0 && (
      <footer class="topic-siblings">
        <h2>Other topics in {group?.label}</h2>
        <div class="sibling-chips">
          {siblings.map((sib) => (
            <a class="sibling-chip" href={`/topics/${sib}`}>
              {TOPICS[sib]}
            </a>
          ))}
        </div>
      </footer>
    )}
  </div>
</Base>

<style>
  .topic-page {
    max-width: 44rem;
    padding-block: 2.25rem 6rem;
  }

  .topic-nav-back {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .group-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .topic-head {
    position: relative;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-tag {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.875rem;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .topic-head h1 {
    font-size: 2.5rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .statement {
    font-family: var(--font-text);
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0 0 2rem;
    text-wrap: pretty;
  }

  .statement em {
    font-style: italic;
    color: var(--ink);
  }

  .topic-meta {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
    margin: 0 0 0.75rem;
  }

  .strip {
    display: flex;
    gap: 2px;
    block-size: 4px;
  }

  .strip span {
    flex: var(--n) 1 0;
    background: var(--k);
    opacity: 0.85;
    border-radius: 2px;
    transition: opacity 0.18s var(--ease);
  }

  .strip:hover span { opacity: 0.35; }
  .strip span:hover { opacity: 1; }

  .entries-section {
    padding-top: 3rem;
  }

  .empty-state {
    font-family: var(--font-text);
    color: var(--ink-muted);
    font-size: 1rem;
    padding: 2rem 0;
  }

  .topic-siblings {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .topic-siblings h2 {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .sibling-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sibling-chip {
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.35rem 0.7rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .sibling-chip:hover {
    border-color: var(--accent);
    color: var(--ink);
  }
</style>
