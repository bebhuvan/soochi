---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { KINDS, KIND_NOTES, keysOf } from '../../taxonomy'

const all = await getCollection('entries')
const live = all.filter((e) => e.data.status !== 'dead')

const kindCounts = new Map<string, number>()
for (const e of live) {
  kindCounts.set(e.data.kind, (kindCounts.get(e.data.kind) ?? 0) + 1)
}

const kinds = keysOf(KINDS).map((k) => ({
  key: k,
  name: KINDS[k],
  note: KIND_NOTES[k],
  count: kindCounts.get(k) ?? 0,
}))

const pageTitle = 'Kinds — Browse Civic Directory by Format'
const pageDesc = `The eight mutually exclusive kinds that categorise every entry in Soochi: Organisations, Data sources, Directories, Tools, Publications, Dashboards, Archives, and Communities.`
const canonicalUrl = new URL('/kinds', Astro.site).toString()

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Soochi Kinds Directory',
    description: pageDesc,
    url: canonicalUrl,
    numberOfItems: kinds.length,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: kinds.map((k, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/kinds/${k.key}`, Astro.site).toString(),
        name: k.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Index', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Kinds', item: canonicalUrl },
    ],
  },
]
---

<Base title={pageTitle} description={pageDesc} schema={schema}>
  <div class="kinds-index-page">
    <div class="page-head">
      <a class="back" href="/">
        <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M6.2 1.4 2.6 5l3.6 3.6" stroke="currentColor" stroke-width="1.4"
            stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        All entries
      </a>
      <p class="section-tag">Directory by kind</p>
      <h1>The 8 Kinds</h1>
      <p class="statement">
        Every entry is exactly one of these. The vocabulary is deliberately
        small — an index where each entry invents its own tags is a list, not
        an index.
      </p>
    </div>

    <ul class="kind-index-table">
      {kinds.map((k) => (
        <li class="kind-row" data-kind={k.key}>
          <a class="kind-row-link" href={`/kinds/${k.key}`}>
            <span class="dot" aria-hidden="true" />
            <span class="k-name">{k.name}</span>
            <span class="k-note">{k.note}</span>
            <span class="k-count">{k.count} {k.count === 1 ? 'entry' : 'entries'}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .kinds-index-page {
    max-width: 44rem;
    padding-block: 2.25rem 6rem;
  }

  .section-tag {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 2rem 0 0.875rem;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .kinds-index-page h1 {
    font-size: 2.5rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .statement {
    font-family: var(--font-text);
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0 0 3rem;
    text-wrap: pretty;
  }

  .kind-index-table {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .kind-row {
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.18s var(--ease);
  }

  .kind-row:hover {
    background: color-mix(in oklab, var(--k) 5%, transparent);
  }

  .kind-row-link {
    display: grid;
    grid-template-columns: 6px 9.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 1.125rem 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .kind-row .dot {
    background: var(--k);
    border-radius: 50%;
    inline-size: 6px;
    block-size: 6px;
    translate: 0 -1px;
  }

  .k-name {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .k-note {
    font-family: var(--font-text);
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .k-count {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 550;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .kind-row-link {
      grid-template-columns: 6px minmax(0, 1fr) auto;
      row-gap: 0.25rem;
    }
    .k-note {
      grid-column: 2 / -1;
    }
  }
</style>
